# Password único para login (cámbialo)
APP_PASSWORD=cambiame

# Secret para firmar la cookie de sesión (genera con: openssl rand -hex 32)
SESSION_SECRET=replace-with-openssl-rand-hex-32

# Tamaño objetivo de fotos procesadas en MB (default 2)
TARGET_SIZE_MB=2

# Lado más largo en píxeles tras resize (default 2560)
MAX_DIMENSION=2560

# Directorio raíz de datos (default ./data; en Docker: /data)
DATA_DIR=./data

# Cookie Secure flag. Auto (Secure si NODE_ENV=production).
# Pon "false" si arrancas pnpm start sin HTTPS y la sesión no se mantiene.
# COOKIE_SECURE=true
