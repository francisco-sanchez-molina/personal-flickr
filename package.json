{
  "name": "personal-flickr",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "start": "node ./dist/server/entry.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "tunnel": "node scripts/tunnel.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "share": "concurrently -k -n app,tunnel -c magenta,cyan \"pnpm dev\" \"pnpm tunnel\"",
    "share:prod": "concurrently -k -n app,tunnel -c magenta,cyan \"pnpm start\" \"pnpm tunnel\"",
    "docker:build": "docker build -t personal-flickr:local .",
    "docker:run": "docker run --rm -p 4321:4321 -v $(pwd)/data:/data --env-file .env personal-flickr:local"
  },
  "dependencies": {
    "@astrojs/node": "^10.1.1",
    "@astrojs/react": "^5.0.5",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@tanstack/react-virtual": "^3.13.26",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "astro": "^6.3.8",
    "better-sqlite3": "^12.10.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "exifr": "^7.1.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-zoom-pan-pinch": "^4.0.3",
    "sharp": "^0.34.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@tailwindcss/vite": "^4.3.0",
    "@vitest/coverage-v8": "^4.1.7",
    "cloudflared": "^0.7.1",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
