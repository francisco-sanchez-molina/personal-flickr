---
import Base from "~/layouts/Base.astro";
import Uploader from "~/components/Uploader.tsx";
import Gallery from "~/components/Gallery.tsx";
import { photoQueries } from "~/lib/db";

const photos = photoQueries.list();
---

<Base>
  <div class="space-y-8">
    <Uploader client:load />
    <section>
      <h2 class="mb-3 text-sm font-medium uppercase tracking-wider text-neutral-400">
        Galería <span class="ml-1 text-neutral-600">({photos.length})</span>
      </h2>
      <Gallery client:load initial={photos} />
    </section>
  </div>
</Base>
