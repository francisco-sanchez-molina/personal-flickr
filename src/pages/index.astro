---
import Base from "~/layouts/Base.astro";
import Gallery from "~/components/gallery/Gallery.tsx";
import GalleriesGrid from "~/components/gallery/GalleriesGrid.tsx";
import SmartAlbumsManager from "~/components/gallery/SmartAlbumsManager.tsx";
import TagsManager from "~/components/gallery/TagsManager.tsx";
import SharesManager from "~/components/share/SharesManager.tsx";
import TrashManager from "~/components/gallery/TrashManager.tsx";
import EmptyState from "~/components/ui/EmptyState.astro";
import SectionHead from "~/components/ui/SectionHead.astro";
import {
  galleryQueries,
  galleryShareQueries,
  photoQueries,
  runSmartFilter,
  search as dbSearch,
  shareQueries,
  smartAlbumQueries,
  tagQueries,
  type SmartFilter,
} from "~/lib/db";

const viewParam = Astro.url.searchParams.get("view");
const tagParam = Astro.url.searchParams.get("tag");
const smartIdParam = Number(Astro.url.searchParams.get("id"));
const q = (Astro.url.searchParams.get("q") ?? "").trim();

const view:
  | "home"
  | "galleries"
  | "photos"
  | "favorites"
  | "orphans"
  | "tags"
  | "smart-albums"
  | "smart"
  | "shares"
  | "trash"
  | "search" = q
  ? "search"
  : viewParam === "galleries"
    ? "galleries"
    : viewParam === "photos"
      ? "photos"
      : viewParam === "favorites"
        ? "favorites"
        : viewParam === "orphans"
          ? "orphans"
          : viewParam === "tags"
            ? "tags"
            : viewParam === "smart-albums"
              ? "smart-albums"
              : viewParam === "smart"
                ? "smart"
                : viewParam === "shares"
                  ? "shares"
                  : viewParam === "trash"
                    ? "trash"
                    : "home";

// Per-view data fetching
let photos: ReturnType<typeof photoQueries.list> = [];
let galleries: ReturnType<typeof galleryQueries.list> = [];
let orphanCount = 0;
let tags: ReturnType<typeof tagQueries.list> = [];
let activeTag: ReturnType<typeof tagQueries.byName> = null;
let recentPhotos: ReturnType<typeof photoQueries.list> = [];
let totalPhotoCount = 0;
let featuredGallery: (typeof galleries)[number] | null = null;
// Smart-album data (only used for view === "smart-albums" / "smart")
let smartAlbums: Array<{ id: number; name: string; filter: SmartFilter }> = [];
let smartAlbumDetail: { id: number; name: string; filter: SmartFilter } | null =
  null;

// Share rows (only used for view === "shares")
let shares: ReturnType<typeof shareQueries.listAll> = [];
let galleryShares: ReturnType<typeof galleryShareQueries.listAll> = [];

// Trash rows (only used for view === "trash")
let trash: ReturnType<typeof photoQueries.listTrash> = [];

if (view === "search") {
  photos = dbSearch.photos(q);
  galleries = dbSearch.galleries(q);
} else if (view === "photos") {
  photos = photoQueries.list();
} else if (view === "favorites") {
  photos = photoQueries.listFavorites();
} else if (view === "orphans") {
  photos = photoQueries.listOrphans();
} else if (view === "tags") {
  tags = tagQueries.list();
  if (tagParam) {
    activeTag = tagQueries.byName(tagParam);
    if (activeTag) photos = tagQueries.photosOfTag(activeTag.id);
  }
} else if (view === "smart-albums") {
  smartAlbums = smartAlbumQueries.list().map((r) => ({
    id: r.id,
    name: r.name,
    filter: safeJson(r.filter_json) as SmartFilter,
  }));
} else if (view === "shares") {
  shares = shareQueries.listAll();
  galleryShares = galleryShareQueries.listAll();
} else if (view === "trash") {
  trash = photoQueries.listTrash();
} else if (view === "smart") {
  if (Number.isInteger(smartIdParam) && smartIdParam > 0) {
    const album = smartAlbumQueries.byId(smartIdParam);
    if (album) {
      const filter = safeJson(album.filter_json) as SmartFilter;
      smartAlbumDetail = { id: album.id, name: album.name, filter };
      photos = runSmartFilter(filter);
    }
  }
} else if (view === "galleries") {
  galleries = galleryQueries.list();
  orphanCount = photoQueries.countOrphans();
} else {
  // Home: hero + galleries strip + recent photos
  galleries = galleryQueries.list();
  orphanCount = photoQueries.countOrphans();
  // Featured = most-recently-updated gallery with a cover photo. Falls back
  // to the first gallery if nothing has a cover yet.
  featuredGallery =
    galleries.find((g) => g.cover_name) ?? galleries[0] ?? null;
  totalPhotoCount = photoQueries.count();
  recentPhotos = photoQueries.listRecent(24);
}

function safeJson(s: string): unknown {
  try {
    return JSON.parse(s);
  } catch {
    return {};
  }
}

const railCurrent =
  view === "favorites"
    ? "favorites"
    : view === "photos"
      ? "photos"
      : view === "tags"
        ? "tags"
        : view === "galleries"
          ? "galleries"
          : "home";

function relativeTime(ts: number): string {
  const diff = Date.now() - ts;
  const days = Math.floor(diff / (1000 * 60 * 60 * 24));
  if (days <= 0) return "hoy";
  if (days === 1) return "ayer";
  if (days < 30) return `hace ${days} días`;
  const months = Math.floor(days / 30);
  if (months === 1) return "hace 1 mes";
  if (months < 12) return `hace ${months} meses`;
  const years = Math.floor(days / 365);
  return years === 1 ? "hace 1 año" : `hace ${years} años`;
}
---

<Base current={railCurrent} topbarTitle={view === "home" ? "Inicio" : undefined}>
  <main class="main">
    {/* Tabs (hidden on Home and Search) */}
    {
      view !== "search" && view !== "home" && (
        <nav class="tabs">
          <a href="/?view=galleries" class:list={{ on: view === "galleries" }}>
            Galerías
          </a>
          <a href="/?view=photos" class:list={{ on: view === "photos" }}>
            Fotos
          </a>
          <a href="/?view=favorites" class:list={{ on: view === "favorites" }}>
            <span class="text-accent">★</span> Favoritas
          </a>
          <a href="/?view=tags" class:list={{ on: view === "tags" }}>
            Etiquetas
          </a>
          <a
            href="/?view=smart-albums"
            class:list={{ on: view === "smart-albums" || view === "smart" }}
          >
            Smart albums
          </a>
          <a href="/?view=shares" class:list={{ on: view === "shares" }}>
            Compartidas
          </a>
          <a href="/?view=trash" class:list={{ on: view === "trash" }}>
            Papelera
          </a>
        </nav>
      )
    }

    {
      view === "home" ? (
        <>
          {/* Featured hero */}
          {featuredGallery && featuredGallery.cover_name && (
            <a
              href={`/g/${featuredGallery.slug}`}
              class="hero block text-inherit no-underline"
            >
              <img
                src={`/files/photo/${encodeURIComponent(featuredGallery.cover_name)}?v=${featuredGallery.cover_developed_at ?? 0}`}
                alt={featuredGallery.name}
              />
              <div class="hero-grade" />
              <div class="hero-body">
                <div>
                  <div class="hero-eyebrow">
                    Galería destacada · {featuredGallery.photo_count}{" "}
                    {featuredGallery.photo_count === 1 ? "foto" : "fotos"}
                  </div>
                  <h1 class="hero-title">{featuredGallery.name}</h1>
                  <div class="hero-meta">
                    {featuredGallery.description
                      ? `${featuredGallery.description} · `
                      : ""}
                    última edición {relativeTime(featuredGallery.updated_at)}
                  </div>
                </div>
                <div class="hero-cta">
                  <button class="btn primary" type="button">
                    ▷ Ver galería
                  </button>
                </div>
              </div>
            </a>
          )}

          {/* Galleries strip */}
          <section class="mb-12">
            <GalleriesGrid
              client:load
              initial={galleries}
              orphanCount={orphanCount}
              featured={false}
            />
          </section>

          {/* Recent photos */}
          {recentPhotos.length > 0 && (
            <section>
              <SectionHead eyebrow="Subidas recientes" title="Últimas fotos">
                <span slot="actions" class="count-chip">
                  {recentPhotos.length} de {totalPhotoCount}
                </span>
              </SectionHead>
              <Gallery client:load initial={recentPhotos} />
            </section>
          )}
        </>
      ) : view === "galleries" ? (
        <GalleriesGrid
          client:load
          initial={galleries}
          orphanCount={orphanCount}
        />
      ) : view === "smart-albums" ? (
        <section>
          <SectionHead
            eyebrow="Filtros guardados"
            title="Smart albums"
          >
            <span slot="actions" class="count-chip">
              {smartAlbums.length}{" "}
              {smartAlbums.length === 1 ? "album" : "albums"}
            </span>
          </SectionHead>
          <SmartAlbumsManager client:load initial={smartAlbums} />
        </section>
      ) : view === "shares" ? (
        <section>
          <SectionHead
            eyebrow="Enlaces públicos"
            title="Compartidas"
          >
            <span slot="actions" class="count-chip">
              {shares.length + galleryShares.length}{" "}
              {shares.length + galleryShares.length === 1 ? "enlace" : "enlaces"}
            </span>
          </SectionHead>
          <SharesManager
            client:load
            initial={shares}
            galleryInitial={galleryShares}
          />
        </section>
      ) : view === "trash" ? (
        <section>
          <SectionHead eyebrow="Borradas recuperables" title="Papelera">
            <span slot="actions" class="count-chip">
              {trash.length} {trash.length === 1 ? "foto" : "fotos"}
            </span>
          </SectionHead>
          <TrashManager
            client:load
            initial={trash.map((p) => ({
              id: p.id,
              name: p.name,
              kind: p.kind,
              developed_at: p.developed_at,
              deleted_at: p.deleted_at,
            }))}
          />
        </section>
      ) : view === "smart" ? (
        <section>
          {smartAlbumDetail ? (
            <>
              <SectionHead
                eyebrow="Smart album"
                title={smartAlbumDetail.name}
              >
                <span slot="actions" class="count-chip">
                  {photos.length}{" "}
                  {photos.length === 1 ? "foto" : "fotos"}
                </span>
              </SectionHead>
              <a
                href="/?view=smart-albums"
                class="btn ghost sm mb-[18px] inline-flex"
              >
                ← Smart albums
              </a>
              {photos.length === 0 ? (
                <EmptyState
                  title="Sin coincidencias."
                  sub="Ajusta el filtro o sube fotos que cumplan los criterios."
                />
              ) : (
                <Gallery client:load initial={photos} />
              )}
            </>
          ) : (
            <EmptyState
              title="Smart album no encontrado."
              sub="Probablemente lo has borrado o el link es viejo."
            />
          )}
        </section>
      ) : view === "tags" && !activeTag ? (
        <section>
          <SectionHead eyebrow="Organizadas por concepto" title="Etiquetas">
            <span slot="actions" class="count-chip">{tags.length} etiquetas</span>
          </SectionHead>
          {tags.length === 0 ? (
            <EmptyState
              title="Aún no hay etiquetas."
              sub='Abre una foto y usa la sección "Etiquetas" del panel lateral para añadirlas.'
            />
          ) : (
            <TagsManager client:load initial={tags} />
          )}
        </section>
      ) : view === "search" ? (
        <section>
          <SectionHead eyebrow="Resultados" title={`“${q}”`}>
            <span slot="actions" class="count-chip">
              {photos.length} {photos.length === 1 ? "foto" : "fotos"} ·{" "}
              {galleries.length}{" "}
              {galleries.length === 1 ? "galería" : "galerías"}
            </span>
          </SectionHead>
          <a href="/" class="btn ghost sm mb-[18px] inline-flex">
            ← Limpiar
          </a>
          {galleries.length > 0 && (
            <div class="mb-8">
              <div class="h-eyebrow mb-2.5">
                Galerías
              </div>
              <GalleriesGrid
                client:load
                initial={galleries}
                orphanCount={0}
                featured={false}
              />
            </div>
          )}
          {photos.length > 0 ? (
            <div>
              <div class="h-eyebrow mb-2.5">
                Fotos
              </div>
              <Gallery client:load initial={photos} />
            </div>
          ) : galleries.length === 0 ? (
            <EmptyState title="Sin resultados." sub="Prueba con otra palabra." />
          ) : null}
        </section>
      ) : (
        <section>
          <div class="section-head">
            <div>
              {view === "tags" && activeTag && (
                <nav class="mb-2.5 text-[13px]">
                  <a href="/?view=tags" class="text-ink-3 no-underline">
                    ← Etiquetas
                  </a>
                </nav>
              )}
              <div class="h-eyebrow mb-2">
                {view === "favorites"
                  ? "Tu selección"
                  : view === "photos"
                    ? "Biblioteca completa"
                    : view === "orphans"
                      ? "Smart album"
                      : "Etiqueta"}
              </div>
              <h2>
                {view === "favorites"
                  ? "Favoritas"
                  : view === "photos"
                    ? "Todas las fotos"
                    : view === "orphans"
                      ? "Sin galería"
                      : activeTag?.name}
              </h2>
            </div>
            <span class="count-chip">
              {photos.length} {photos.length === 1 ? "foto" : "fotos"}
            </span>
          </div>
          {view === "orphans" && (
            <p class="mt-[-6px] mb-[22px] font-mono text-[12.5px] tracking-[.02em] text-ink-3">
              Fotos que aún no están en ninguna galería. Al añadirlas a una
              galería desaparecen de esta lista.
            </p>
          )}
          {photos.length === 0 ? (
            <EmptyState
              title={
                view === "favorites"
                  ? "Aún no tienes favoritas."
                  : view === "orphans"
                    ? "Todo está clasificado."
                    : view === "tags"
                      ? "Sin fotos."
                      : "Aún no hay fotos."
              }
              sub={
                view === "favorites"
                  ? "Toca la estrella en cualquier foto para guardarla aquí."
                  : view === "orphans"
                    ? "Cada foto está en al menos una galería."
                    : view === "tags"
                      ? "Esta etiqueta no está en ninguna foto."
                      : "Usa Subir fotos para empezar."
              }
            />
          ) : (
            <Gallery
              client:load
              initial={photos}
              orphans={view === "orphans"}
            />
          )}
        </section>
      )
    }
  </main>
</Base>
