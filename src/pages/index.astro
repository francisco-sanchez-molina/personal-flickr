---
import Base from "~/layouts/Base.astro";
import Gallery from "~/components/Gallery.tsx";
import GalleriesGrid from "~/components/GalleriesGrid.tsx";
import { galleryQueries, photoQueries } from "~/lib/db";

// Default landing = Galerías. Photos and Favoritas are opt-in via ?view=.
// We accept ?view=galleries as an alias of "/" for backwards-compatible links.
const viewParam = Astro.url.searchParams.get("view");
const view: "galleries" | "photos" | "favorites" =
  viewParam === "photos"
    ? "photos"
    : viewParam === "favorites"
      ? "favorites"
      : "galleries";

const photos =
  view === "photos"
    ? photoQueries.list()
    : view === "favorites"
      ? photoQueries.listFavorites()
      : [];
const galleries = view === "galleries" ? galleryQueries.list() : [];
---

<Base>
  <div class="space-y-6">
    {/* View toggle — Galerías is the default landing tab */}
    <nav class="flex gap-1 border-b border-neutral-800">
      <a
        href="/"
        class:list={[
          "rounded-t-md px-4 py-2 text-sm font-medium transition",
          view === "galleries"
            ? "border-b-2 border-pink-500 text-neutral-100"
            : "text-neutral-400 hover:bg-neutral-900 hover:text-neutral-100",
        ]}
      >
        Galerías
      </a>
      <a
        href="/?view=photos"
        class:list={[
          "rounded-t-md px-4 py-2 text-sm font-medium transition",
          view === "photos"
            ? "border-b-2 border-pink-500 text-neutral-100"
            : "text-neutral-400 hover:bg-neutral-900 hover:text-neutral-100",
        ]}
      >
        Fotos
      </a>
      <a
        href="/?view=favorites"
        class:list={[
          "rounded-t-md px-4 py-2 text-sm font-medium transition",
          view === "favorites"
            ? "border-b-2 border-amber-400 text-neutral-100"
            : "text-neutral-400 hover:bg-neutral-900 hover:text-neutral-100",
        ]}
      >
        <span style="color:#fbbf24">★</span> Favoritas
      </a>
    </nav>

    {
      view === "galleries" ? (
        <GalleriesGrid client:load initial={galleries} />
      ) : (
        <section>
          <h2 class="mb-3 text-sm font-medium uppercase tracking-wider text-neutral-400">
            {view === "favorites" ? "Favoritas" : "Todas las fotos"}{" "}
            <span class="ml-1 text-neutral-600">({photos.length})</span>
          </h2>
          <Gallery client:load initial={photos} />
        </section>
      )
    }
  </div>
</Base>
