---
import Base from "~/layouts/Base.astro";
import Gallery from "~/components/Gallery.tsx";
import GalleriesGrid from "~/components/GalleriesGrid.tsx";
import { galleryQueries, photoQueries } from "~/lib/db";

const viewParam = Astro.url.searchParams.get("view");
const view: "galleries" | "photos" | "favorites" | "orphans" =
  viewParam === "photos"
    ? "photos"
    : viewParam === "favorites"
      ? "favorites"
      : viewParam === "orphans"
        ? "orphans"
        : "galleries";

const photos =
  view === "photos"
    ? photoQueries.list()
    : view === "favorites"
      ? photoQueries.listFavorites()
      : view === "orphans"
        ? photoQueries.listOrphans()
        : [];

const galleries = view === "galleries" ? galleryQueries.list() : [];
const orphanCount = view === "galleries" ? photoQueries.countOrphans() : 0;

const railCurrent =
  view === "favorites"
    ? "favorites"
    : view === "photos"
      ? "photos"
      : "galleries";

const eyebrowText =
  view === "favorites"
    ? "Tu selección"
    : view === "photos"
      ? "Biblioteca completa"
      : view === "orphans"
        ? "Smart album"
        : "Colecciones temáticas";
const heading =
  view === "favorites"
    ? "Favoritas"
    : view === "photos"
      ? "Todas las fotos"
      : view === "orphans"
        ? "Sin galería"
        : "Galerías";
---

<Base current={railCurrent}>
  <main class="main">
    {/* View toggle */}
    <nav class="tabs">
      <a href="/" class:list={{ on: view === "galleries" }}>Galerías</a>
      <a href="/?view=photos" class:list={{ on: view === "photos" }}>Fotos</a>
      <a href="/?view=favorites" class:list={{ on: view === "favorites" }}>
        <span style="color:var(--accent)">★</span> Favoritas
      </a>
    </nav>

    {
      view === "galleries" ? (
        <GalleriesGrid
          client:load
          initial={galleries}
          orphanCount={orphanCount}
        />
      ) : (
        <section>
          <div class="section-head">
            <div>
              <div class="h-eyebrow" style="margin-bottom:8px;">
                {eyebrowText}
              </div>
              <h2>{heading}</h2>
            </div>
            <span class="count-chip">
              {photos.length} {photos.length === 1 ? "foto" : "fotos"}
            </span>
          </div>
          {view === "orphans" && (
            <p
              style="margin:-6px 0 22px;color:var(--ink-3);font-size:12.5px;font-family:var(--f-mono);letter-spacing:.02em;"
            >
              Fotos que aún no están en ninguna galería. Al añadirlas a una galería
              desaparecen de esta lista.
            </p>
          )}
          {photos.length === 0 ? (
            <div class="empty">
              <div class="big serif">
                {view === "favorites"
                  ? "Aún no tienes favoritas."
                  : view === "orphans"
                    ? "Todo está clasificado."
                    : "Aún no hay fotos."}
              </div>
              <div>
                {view === "favorites"
                  ? "Toca la estrella en cualquier foto para guardarla aquí."
                  : view === "orphans"
                    ? "Cada foto está en al menos una galería."
                    : "Usa Subir fotos para empezar."}
              </div>
            </div>
          ) : (
            <Gallery
              client:load
              initial={photos}
              orphans={view === "orphans"}
            />
          )}
        </section>
      )
    }
  </main>
</Base>
