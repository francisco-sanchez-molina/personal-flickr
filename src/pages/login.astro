---
import Base from "~/layouts/Base.astro";
const error = Astro.url.searchParams.get("error");
---

<Base title="Login · Personal Flickr">
  <main class="grid min-h-screen place-items-center p-6">
    <div
      class="w-[min(420px,100%)] rounded-[20px] border border-line bg-surface px-7 py-9 shadow-[var(--shadow-card)]"
    >
      <div class="mb-6 text-center">
        <div
          class="rail-logo mx-auto mb-4 h-12 w-12 text-2xl"
        >
          ●
        </div>
        <h1
          class="serif m-0 text-[32px] font-normal tracking-[-0.02em]"
        >
          Personal Flickr
        </h1>
        <p
          class="mono mt-1.5 text-[11.5px] tracking-[.08em] text-ink-3 uppercase"
        >
          Galería privada
        </p>
      </div>

      <form method="POST" action="/api/auth/login" class="grid gap-3">
        <div class="search px-3.5 py-3">
          <input
            type="password"
            name="password"
            placeholder="Contraseña"
            autofocus
            required
            class="text-[14px]"
          />
        </div>
        {
          error && (
            <p class="m-0 font-mono text-[12.5px] text-danger">
              Contraseña incorrecta
            </p>
          )
        }
        <button type="submit" class="btn primary justify-center">
          Entrar
        </button>
      </form>
    </div>
  </main>
</Base>
