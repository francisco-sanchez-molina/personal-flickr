---
import "~/styles/global.css";
import Rail from "~/components/nav/Rail.tsx";
import Topbar from "~/components/nav/Topbar.tsx";
import ConfirmHost from "~/components/ui/ConfirmDialog.tsx";
import UploaderModal from "~/components/upload/UploaderModal.tsx";

interface Props {
  title?: string;
  /** Active rail item. Defaults to "galleries". */
  current?:
    | "home"
    | "photos"
    | "galleries"
    | "favorites"
    | "tags"
    | "map"
    | "other";
  /** Title shown in the topbar when no breadcrumb chain is set. */
  topbarTitle?: string;
  /**
   * Breadcrumb chain rendered in the topbar (`Galerías / Viajes / Roma`).
   * The last entry is treated as the current page — no link. Earlier
   * entries link via their `href`.
   */
  breadcrumb?: Array<{ name: string; href?: string }>;
  /** When set, uploads default to this gallery (used on /g/{slug}). */
  currentGallery?: { id: number; name: string };
}
const {
  title = "Personal Flickr",
  current = "galleries",
  topbarTitle,
  breadcrumb,
  currentGallery,
} = Astro.props;
const authed = Astro.locals.user != null;
---

<!doctype html>
<html lang="es" data-mood="estudio" data-theme="dark" data-density="regular">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>

    {/* Editorial display + UI fonts from the design handoff */}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@300;400;500&display=swap"
    />

    {/* Apply persisted mood / theme BEFORE hydration to avoid a flash */}
    <script is:inline>
      (function () {
        try {
          var m = localStorage.getItem("pf:mood");
          var t = localStorage.getItem("pf:theme");
          var d = localStorage.getItem("pf:density");
          if (m) document.documentElement.setAttribute("data-mood", m);
          if (t) document.documentElement.setAttribute("data-theme", t);
          if (d) document.documentElement.setAttribute("data-density", d);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    {
      currentGallery && (
        <script is:inline define:vars={{ g: currentGallery }}>
          {`window.__currentGallery = ${JSON.stringify(currentGallery)};`}
        </script>
      )
    }

    {
      authed ? (
        <div class="app">
          <Rail client:load current={current} />
          <div class="canvas">
            <Topbar
              client:load
              title={topbarTitle}
              breadcrumb={breadcrumb}
              current={current}
            />
            <slot />
          </div>
        </div>
      ) : (
        <slot />
      )
    }

    {authed && <UploaderModal client:load />}
    {authed && <ConfirmHost client:load />}
  </body>
</html>
